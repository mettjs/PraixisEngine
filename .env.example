# ──────────────────────────────────────────────────────────────────────────────
# REQUIRED IN ALL MODES
# ──────────────────────────────────────────────────────────────────────────────

# LLM Backend (any OpenAI-compatible server)
AI_API_URL=http://localhost:8081      # Base URL of your OpenAI-compatible LLM server
AI_API_KEY=your-llm-api-key           # API key for the LLM server (can be any string for local setups)
MODEL_NAME=gemma3:12b                 # Model name as recognized by your LLM server

# --- vLLM backend (docker-compose.vllm.yml) ---
# Used only by the vLLM overlay. AI_API_URL/MODEL_NAME above are overridden by
# that overlay to point at the in-network vllm service, so you don't edit them.
# VLLM_MODEL is a HuggingFace repo ID (NOT an Ollama tag like gemma3:12b) and
# sets both the loaded model and its served name. Gemma is gated — accept the
# license on HuggingFace and set HUGGING_FACE_HUB_TOKEN. Use an ungated model
# (e.g. Qwen/Qwen2.5-3B-Instruct) to skip the token.
VLLM_MODEL=google/gemma-4-E4B-it
# HUGGING_FACE_HUB_TOKEN=hf_xxx

# --- LiteLLM + Ollama backend (docker-compose.litellm.yml) ---
# Used only by the LiteLLM overlay, which overrides AI_API_URL/AI_API_KEY/
# MODEL_NAME above to point at the in-network litellm proxy. LITELLM_MODEL must
# match a model_name in litellm_config.yaml. No GPU required (Mac-friendly).
LITELLM_MODEL=gemma4:e4b
LITELLM_MASTER_KEY=sk-litellm-local

# Admin panel credentials
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_admin_password

# ──────────────────────────────────────────────────────────────────────────────
# REDIS + VECTOR STORE
#
# Redis is required in all modes. POSTGRES_URL is required when running locally
# (uv run ...) or via `make up` (API-only docker compose — you bring your own
# Redis and Postgres). Both are auto-overridden by docker-compose.local.yml when
# you run `make up-local`, so for that mode you can leave them unset.
# ──────────────────────────────────────────────────────────────────────────────

# Redis
# Local: redis://localhost:6379/0
# With password: redis://:password@host:6379/0
# TLS (Upstash, remote): rediss://:password@host:6380/0
REDIS_URL=redis://localhost:6379/0

# Vector store backend — pick BEFORE uploading documents (no migration between them):
#   pgvector  Postgres + pgvector. Hybrid retrieval (dense + full-text fused with
#             RRF) — better on keyword-ish queries (names, article numbers, codes).
#   chroma    Embedded ChromaDB persisted to CHROMA_PATH. No extra database to
#             run; retrieval is pure vector similarity.
# Improved Search (question indexing) works on both.
VECTOR_BACKEND=pgvector

# PostgreSQL — pgvector backend only
# (must have the pgvector extension available — pgvector/pgvector image works out of the box)
POSTGRES_URL=postgresql://praixis:yourpassword@localhost:5432/praixis

# Chroma backend only: where the embedded database persists its data
# CHROMA_PATH=./chroma_data

# ──────────────────────────────────────────────────────────────────────────────
# TUNABLES (sensible defaults — override only if you need to)
# ──────────────────────────────────────────────────────────────────────────────

# Session
SESSION_TTL=86400                     # Session expiry in seconds (default: 24 hours)
# Token budget for a session's conversation history (estimated at ~4 chars per
# token). When a session reaches ~80% of this, older exchanges are automatically
# compacted into an LLM-written summary (the last 3 exchanges are kept verbatim),
# so long conversations retain their context instead of losing their oldest turns.
# Size it to your model's context window, leaving room for the completion and,
# on RAG requests, the retrieved context.
CONTEXT_WINDOW=8192

# Embedding model (used by the RAG pipeline for document and query vectors)
# Must be a model name supported by fastembed. Change requires re-uploading all collections.
# EMBEDDING_DIMS must match the model's output dimension — startup will fail with a
# clear error if they don't. Both must be set together when overriding the default.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMS=384

# LLM concurrency
# Total simultaneous LLM calls allowed across the entire deployment. Enforced
# globally via a Redis-backed token bucket, so the cap holds across multiple
# uvicorn workers and container replicas sharing the same Redis. Set to 1 for
# a large model on a single GPU; raise it if your backend has headroom.
# NOTE on vLLM: vLLM does continuous batching and serves many requests in
# parallel, so this cap should be RAISED substantially (e.g. 16+) or it becomes
# the bottleneck instead of the GPU. The real ceiling is KV-cache capacity, which
# scales with VRAM and inversely with --max-model-len; a 4B model on a 24GB GPU
# comfortably handles dozens. Treat this as global backpressure, not a 1:1 GPU map.
GPU_CONCURRENCY=2
# Max seconds a request waits for a free slot before returning 503.
GPU_WAIT_TIMEOUT=30
# Per-worker cap on concurrent LLM calls inside the file_summary map-reduce
# pipeline. Only has effect when lower than GPU_CONCURRENCY — use it to
# reserve global slots for chat/RAG requests while a large file is processed.
CHUNK_CONCURRENCY=4

# Improved Search — hypothetical-question indexing
# Opt-in per upload (improved_search=true). After a document is stored, an LLM
# generates the plain-language questions each chunk answers; those are embedded
# and indexed so conversational queries match formal/technical text better.
# Generation runs in the background on a DEDICATED GPU pool (below).
HQ_ENABLED=true                       # Global on/off switch; false disables generation everywhere
HQ_PER_CHUNK=5                        # Questions generated per chunk

# Dedicated, SEPARATE GPU pool for background question generation, so it never
# starves interactive chat/RAG and is never starved by it. Total simultaneous
# LLM calls the deployment can issue = GPU_CONCURRENCY + HQ_GPU_CONCURRENCY.
#   - Backend has headroom: keep additive (e.g. 2 + 1 = up to 3 concurrent).
#   - Fixed total budget: lower GPU_CONCURRENCY to carve a slot out (e.g. 1 + 1 = 2).
#   - Set to 0 to disable the reserve (generation falls back to the shared pool).
HQ_GPU_CONCURRENCY=1
# Seconds a background generation call waits for a reserved slot before skipping
# a chunk. Long, because generation is best-effort background work.
HQ_GPU_WAIT_TIMEOUT=300
